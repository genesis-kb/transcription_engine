[DEFAULT]
asr_provider = whisper
diarize = True
summarize = False
github = False
save_to_markdown = True
needs_review = False
one_sentence_per_line = True
# VibeVoice chunk length in seconds (only used when asr_provider = vibevoice)
vibevoice_chunk_length = 180

llm_provider = openai
# For local gemma via Ollama, use:
# llm_provider = gemma
llm_correction_model = gpt-4o
# llm_correction_model = gemma3:4b
llm_summary_model = gpt-4o

[development]
verbose_logging = True
server_mode = dev
server_verbose = True
